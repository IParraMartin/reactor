 "training": {
  "summary": "Heads trained on a frozen Qwen3.5-4B-Base with 31 corpora mixed by temperature sampling; three seeds, each the checkpoint with the best validation score, averaged at prediction time.",
  "data": {
   "datasets": 31,
   "split": "80/10/10 by text, within each dataset; translations (MECO) and text versions (OneStop) share a split",
   "split_seed": 0,
   "min_readers": 3,
   "reader_weight": "n / (n + 5) for a word read by n readers",
   "sampling": "dataset drawn with probability proportional to size^0.5",
   "duration_bounds_ms": {
    "et": [
     80,
     6000
    ],
    "spr": [
     100,
     3000
    ]
   }
  },
  "targets": {
   "measures": {
    "ffd": "first-fixation duration (ms)",
    "gd": "gaze duration (ms)",
    "gpt": "go-past time (ms)",
    "trt": "total reading time (ms)",
    "fix_prob": "first-pass fixation probability",
    "reg_prob": "first-pass regression probability",
    "rt": "self-paced reading time (ms)"
   },
   "aggregation": "durations: mean log duration over readers (eye tracking: readers who fixated the word); probabilities: share of readers",
   "normalization": "log durations z-scored per dataset, condition and reader group"
  },
  "inputs": {
   "prompt": "Language: {language}. Measure: {paradigm}. Task: {condition}. Readers: {native|non-native} speakers.",
   "features": [
    "log_length",
    "zipf",
    "zipf_missing",
    "surprisal",
    "entropy",
    "relative_position",
    "sentence_start",
    "sentence_end",
    "punctuation_end",
    "line_start",
    "line_end",
    "line_known"
   ],
   "windows": {
    "context_words": 64,
    "max_tokens": 1024,
    "target_words": 256
   },
   "pool": "hidden state of each word's last subword token"
  },
  "architecture": {
   "backbone": "Qwen/Qwen3.5-4B-Base (frozen, bfloat16)",
   "head": {
    "d_model": 512,
    "dataset_dropout": 0.1,
    "dropout": 0.2,
    "feature_skip_kernel": 5,
    "kernel_size": 5,
    "max_words": 1024,
    "mixer_heads": 8,
    "mixer_layers": 1,
    "num_mixes": 2,
    "type": "full"
   },
   "description": "two learned layer mixes, feature fusion, dataset FiLM (dropped 10% of the time to learn a generic reader), local convolution plus a one-layer bidirectional word Transformer, linear outputs with a feature skip"
  },
  "loss": {
   "durations": "Huber (delta 1.0) on z-scored log durations",
   "probabilities": "binary cross-entropy with soft targets",
   "task_weights": {
    "ffd": 1.0,
    "fix_prob": 1.0,
    "gd": 1.0,
    "gpt": 1.0,
    "reg_prob": 0.5,
    "rt": 1.0,
    "trt": 1.0
   },
   "masking": "measures a corpus does not provide are left out of the loss"
  },
  "optimisation": {
   "optimizer": "AdamW (betas 0.9, 0.98)",
   "learning_rate": 0.001,
   "schedule": "cosine with 3% warmup",
   "weight_decay": 0.01,
   "max_grad_norm": 1.0,
   "batch": "up to 16384 padded tokens and 32 windows",
   "max_epochs": 20,
   "early_stopping": "validation macro Pearson every 60 steps, patience 8"
  },
  "compute": {
   "hardware": "one NVIDIA A40 (48 GB) per seed",
   "minutes_per_seed": [
    117,
    95,
    99
   ],
